# ==========================================
# IDX Pro - Screener & AI Strategy Lab
# Environment Variables Template for Vercel / Production
# ==========================================

# Zapi Data Integration (Berita IDX, Market Feed)
ZAPI_API_KEY=your_zapi_api_key_here

# DeepSeek AI Engine (Analisa Saham, Makro, Koran IDX)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Discord Webhooks
# 1. Webhook Laporan Analisa Pasar (Sesi 1 Jam 10:00 & Sesi 2 Jam 15:00 WIB)
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# 2. Webhook Koran Harian Pasar Modal IDX
DISCORD_KORAN_WEBHOOK_URL=your_discord_koran_webhook_url_here

# Database (Opsional - Postgres / Neon / Supabase untuk persistensi portfolio lanjutan)
DATABASE_URL=
